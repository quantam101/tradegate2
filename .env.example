# Domain Configuration
SITE_DOMAIN=tradegate.alreadyherellc.com
ACME_EMAIL=ops@alreadyherellc.com

# Public URLs
PUBLIC_SITE_URL=https://tradegate.alreadyherellc.com
COMMAND_CENTER_URL=https://app.tradegate.alreadyherellc.com

# Postgres
POSTGRES_DB=gmaos
POSTGRES_USER=gmaos
POSTGRES_PASSWORD=

# ── TokenForge LLM proxy (free, multi-provider) ───────────────────────────
# Routes: GET/POST /api/tokenforge   GET /api/tokenforge-demo (cached 1hr)
# Variable: TOKENFORGE_API_KEY  (set in Vercel env vars, not here)
# Variable: TOKENFORGE_API_URL  (default: https://api.alreadyherellc.com)
TOKENFORGE_API_URL=https://api.alreadyherellc.com

# ── Free AI inference ──────────────────────────────────────────────────────
# Groq: 700+ tok/s, free tier — https://console.groq.com
# Variable: GROQ_API_KEY  (set in server .env, not here)
GMAOS_GROQ_MODEL=llama-3.3-70b-versatile
# Gemini: free, 1M context — https://aistudio.google.com
# Variable: GEMINI_API_KEY  (set in server .env, not here)
GMAOS_GEMINI_MODEL=gemini-1.5-flash

# ── YouTube Data API v3 ───────────────────────────────────────────────────
# Used by /api/youtube — search for trading videos, market commentary, etc.
# Free tier: 10 000 units/day. Results cached 10 min (ISR revalidate=600).
# Create key: console.cloud.google.com → APIs → YouTube Data API v3
# Variable: YOUTUBE_API_KEY  (set in Vercel env vars + GitHub Secrets, not here)

# ── Stripe (payments + dispatch) ──────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY must be sk_live_… in production, sk_test_… for testing.
# WARNING: Never commit real keys. Set these in Vercel env vars only.
STRIPE_SECRET_KEY=
# Get from: Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
# Endpoint must be set to: https://app.alreadyherellc.com/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Stripe webhook events to enable in dashboard:
#   payment_intent.succeeded, payment_intent.payment_failed,
#   checkout.session.completed, invoice.paid, invoice.payment_failed,
#   customer.subscription.created, customer.subscription.updated,
#   customer.subscription.deleted

# ── WorkMarket / ADP ──────────────────────────────────────────────────────────
# WorkMarket is now part of ADP. Obtain credentials from:
#   WorkMarket → Settings → API Access
# Account verification: https://www.workmarket.com/payments
# ADP portal: https://run.adp.com
WORKMARKET_API_TOKEN=
WORKMARKET_COMPANY_ID=
ADP_CLIENT_ID=

# NextAuth
NEXTAUTH_URL=https://app.alreadyherellc.com
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
